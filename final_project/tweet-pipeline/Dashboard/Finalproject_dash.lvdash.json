{
  "datasets": [
    {
      "name": "7028cb48",
      "displayName": "total tweets counter",
      "queryLines": [
        "SELECT COUNT(*) AS total_tweets\n",
        "FROM workspace.default.tweets_bronze;\n"
      ]
    },
    {
      "name": "290c56a2",
      "displayName": "Tweets with Mentions Counter",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_with_mentions\n",
        "FROM workspace.default.tweets_silver\n",
        "WHERE mention IS NOT NULL;\n"
      ]
    },
    {
      "name": "dda59895",
      "displayName": "Tweets without Mentions Counter",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_without_mentions\n",
        "FROM workspace.default.tweets_silver\n",
        "WHERE mention IS NULL;\n"
      ]
    },
    {
      "name": "313752b4",
      "displayName": "Top 10 Users by Tweet Count",
      "queryLines": [
        "SELECT user, COUNT(*) AS tweet_count\n",
        "FROM workspace.default.tweets_bronze\n",
        "GROUP BY user\n",
        "ORDER BY tweet_count DESC\n",
        "LIMIT 10;\n"
      ]
    },
    {
      "name": "f5b055ba",
      "displayName": "Top 20 Most Positively Mentioned",
      "queryLines": [
        "SELECT mention, positive_count\n",
        "FROM workspace.default.tweets_gold_aggregations\n",
        "ORDER BY positive_count DESC\n",
        "LIMIT 20;\n"
      ]
    },
    {
      "name": "06deeef6",
      "displayName": "Top 10 Most Negatively Mentioned",
      "queryLines": [
        "SELECT mention, negative_count\n",
        "FROM workspace.default.tweets_gold_aggregations\n",
        "ORDER BY negative_count DESC\n",
        "LIMIT 20;\n"
      ]
    }
  ],
